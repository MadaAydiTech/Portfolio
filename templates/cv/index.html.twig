{% extends 'base.html.twig' %}

{% block title %}Mon CV{% endblock %}

{% block body %}
<div class="cv-container">
    <div class="no-print" style="text-align: right; margin-bottom: 20px;">
        <button onclick="window.print()" class="btn btn-primary">
            Imprimer le CV
        </button>
    </div>

    <header class="cv-header">
        <img src="{{ asset('cv/mon_profil.png') }}" alt="tête_de_Adam" class="cv-photo">
        <div class="cv-header-text">
            <h1>ADMINISTRATEUR RÉSEAUX</h1>
            <p class="cv-titre-sous">Alternance Étudiant en 1ère année de BUT Réseaux et Télécommunications</p>
        </div>
    </header>

    <div class="cv-layout">
        <aside class="cv-sidebar">

            <section class="cv-bloc">
                <h2>Informations personnelles</h2>
                <ul>
                    <li>Adam ABIDERRAHMANE</li>
                    <li>abiderrahmane.adam@gmail.com</li>
                    <li>+33 6 56 68 97 13</li>
                    <li>Lyon/Roanne</li>
                    <li>19 ans</li>
                    <li>IUT de Roanne</li>
                    <li><a href="https://linkedin.com/in/adam-ad" target="_blank">linkedin.com/in/adam-ad</a></li>
                    <li><a href="https://github.com/MadaAydiTech" target="_blank">@MadaAydiTech</a></li>
                </ul>
            </section>

            <section class="cv-bloc">
                <h2>Langues</h2>
                <ul>
                    <li><strong>Français :</strong> Langue maternelle</li>
                    <li><strong>Anglais :</strong> Niveau B1</li>
                    <li><strong>Allemand :</strong> Niveau A2</li>
                    <li><strong>Arabe :</strong> Niveau A2</li>
                </ul>
            </section>

            <section class="cv-bloc">
                <h2>Certifications</h2>
                <ul>
                    <li><strong>ANSSI – SecNumacadémie</strong><br><small>20 Septembre 2025</small></li>
                    <li><strong>Cisco – Introduction to Cybersecurity</strong><br><small>18 Février 2026</small></li>
                    <li><strong>Cisco – Networking Basics</strong><br><small>1 Avril 2026</small></li>
                    <li><strong>Commission prévention harcèlement</strong><br><small>2025</small></li>
                </ul>
            </section>

            <section class="cv-bloc">
                <h2>Atouts</h2>
                <ul>
                    <li><strong>Communiquer à l'écrit :</strong> Rédaction de documentations techniques et rapports disponibles sur GitHub.</li>
                    <li><strong>Utiliser le numérique :</strong> Pack Office, Cisco Packet Tracer, Wireshark, VirtualBox, VMware, Visual Studio Code.</li>
                    <li><strong>Travail en équipe :</strong> Collaboration en groupe lors des travaux pratiques.</li>
                </ul>
            </section>

            <section class="cv-bloc">
                <h2>Disponibilités</h2>
                <p>Disponible en alternance dès septembre 2026 (12 à 24 mois)</p>
            </section>

        </aside>

        <main class="cv-main">

            <section class="cv-bloc">
                <h2>Profil</h2>
                <p>
                    Étudiant en 1ère année à l'IUT de Roanne en BUT Réseaux et Télécommunications, je suis à la recherche d'une alternance de 12 à 24 mois pour approfondir mes compétences en architecture réseau, adressage IP et administration système. 
                    Certifié Cisco et badge ANSSI SecNumacadémie, je souhaite intégrer une équipe dynamique dès septembre 2026.
                </p>
            </section>

            <section class="cv-bloc">
                <h2>Formations</h2>
                <div class="timeline-item">
                    <h3>BUT Réseaux et Télécommunications 1ère année</h3>
                    <p class="date">Depuis fin (septembre) 2025 IUT de Roanne, Université Jean Monnet</p>
                    <ul>
                        <li>Administration et fonctionnement des réseaux informatiques</li>
                        <li>Configuration et gestion de réseaux locaux (LAN), modèles OSI / TCP-IP</li>
                        <li>Adressage IP et sous-réseaux, diagnostic réseau (N1/N2)</li>
                        <li>Bases des systèmes d'exploitation (Linux / Windows)</li>
                        <li>Étude des supports de transmission</li>
                    </ul>

                    <h3>Baccalauréat général Terminale</h3>
                    <p class="date">2023–2025 Lycée La Martinière Diderot, Lyon</p>
                    <ul>
                        <li>Spécialités : Mathématiques, NSI (Numérique et Sciences Informatiques)</li>
                    </ul>

                    <h3>Diplôme National du Brevet Mention Bien</h3>
                    <p class="date">2019–2022 – Collège Jules Michelet, Vénissieux</p>
                </div>
            </section>

            <section class="cv-bloc">
                <h2>Expériences professionnelles</h2>
                <div class="timeline-item">
                    <h3>Stage d'observation Informatique et Monétique</h3>
                    <p class="date">2022 AVEM, Lyon</p>
                    <ul>
                        <li>Découverte du fonctionnement d'une entreprise spécialisée en solutions de paiement</li>
                        <li>Observation des systèmes informatiques et des infrastructures techniques</li>
                        <li>Compréhension de l'organisation et des métiers du numérique</li>
                    </ul>
                    <h3>Engagements</h3>
                    <ul>
                        <li>Membre de la Commission contre le harcèlement</li>
                        <li>Cordées de la réussite</li>
                        <li>Médiateur en CM2</li>
                        <li>Association Course contre la faim</li>
                    </ul>
                </div>
            </section>

            <section class="cv-bloc">
                <h2>Compétences</h2>
                <div class="competences-grid">
                    <div class="competence-bloc">
                        <h3>Réseaux et Systèmes</h3>
                        <ul>
                            <li>Configuration LAN, VLAN, OSI/TCP-IP, adressage IP</li>
                            <li>DNS, DHCP, SMB, NAT, ACL, routage RIP</li>
                            <li>Linux/Windows, Docker, Portainer, VMware, VirtualBox</li>
                        </ul>
                    </div>
                    <div class="competence-bloc">
                        <h3>Télécommunications</h3>
                        <ul>
                            <li>Supports de transmission (cuivre, fibre mono/multimode)</li>
                            <li>Signal, multiplexage, transmission numérique</li>
                            <li>Téléphonie VoIP : 3CX, FreePBX</li>
                        </ul>
                    </div>
                    <div class="competence-bloc">
                        <h3>Programmation</h3>
                        <ul>
                            <li>HTML/CSS, Bootstrap, Symfony</li>
                            <li>Python, C, C++ (Arduino), SQL (Access)</li>
                            <li>GitHub, Visual Studio Code, GeoGebra</li>
                        </ul>
                    </div>
                    <div class="competence-bloc">
                        <h3>Autres</h3>
                        <ul>
                            <li>Pack Office (Word, Excel, PowerPoint)</li>
                            <li>Auto-gestion du temps et des priorités</li>
                            <li>Proactif dans la résolution de problèmes</li>
                        </ul>
                    </div>
                </div>
            </section>

            <section class="cv-bloc">
                <h2>Compétences transversales</h2>
                <div class="Bagages-de-competence">
                    <span class="competences">Persévérance: analyse des erreurs et répétition jusqu'à maîtrise complète</span>
                    <span class="competences">Rigueur et sens du détail: vérification méthodique de chaque étape</span>
                    <span class="competences">Autonomie: planification personnelle</span>
                    <span class="competences">Esprit d'équipe: collaboration active lors des travaux pratiques</span>
                </div>
            </section>

            <section class="cv-bloc">
                <h2>Centres d'intérêt</h2>
                <div class="Bagages-de-competence">
                    <span class="competences">Basket-ball (4 ans), Futsal (3 ans), Volleyball</span>
                    <span class="competences">Auto-formation informatique, veille technologique</span>
                    <span class="competences">Lecture, animation japonaise</span>
                </div>
            </section>

        </main>
    </div>
</div>

<style>
body {
    background-color: white;
}

.cv-container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 20px;
    font-family: Arial, sans-serif;
}

.cv-header {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 1.5em;
    padding: 1em 0;
    border-bottom: 3px solid #ff5a13;
}

.cv-photo {
    width: 200px;
    height: 200px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid #ff5a13;
    flex-shrink: 0;
}

.cv-header-text h1 {
    font-size: 2em;
    color: #2c3e50;
    margin: 0 0 0.2em 0;
}

.cv-titre-sous {
    color: #ff5a13;
    font-size: 1em;
    margin: 0;
}

.cv-layout {
    display: flex;
    gap: 2em;
}

.cv-sidebar {
    width: 280px;
    flex-shrink: 0;
}

.cv-main {
    flex: 1;
}

.cv-bloc {
    margin-bottom: 1.5em;
    padding: 1em;
}

.cv-bloc h2 {
    font-size: 1.3em;
    margin-bottom: 0.7em;
    padding-bottom: 0.5em;
    border-bottom: 2px solid #ff5a13;
    color: #2c3e50;
}

.cv-bloc h3 {
    font-size: 1.1em;
    margin-bottom: 0.3em;
    margin-top: 1em;
    color: #34495e;
}

.cv-bloc ul {
    margin: 0;
    padding-left: 1.2em;
    list-style: disc;
}

.cv-bloc ul li {
    font-size: 0.95em;
    padding: 0.2em 0;
    line-height: 1.5;
}

.cv-bloc p {
    font-size: 1em;
    margin: 0.5em 0;
    line-height: 1.6;
}

.date {
    color: #ff5a13;
    font-style: italic;
    font-size: 0.9em !important;
    margin-top: 0 !important;
}

.competence-bloc {
    padding: 1em;
    margin-bottom: 1em;
    border-left: 4px solid #ff5a13;
    background: #f8f9fa;
}

.competences-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1em;
}

.Bagages-de-competence {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5em;
}

.competences {
    background: #f8f9fa;
    border-left: 3px solid #ff5a13;
    padding: 0.4em 0.8em;
    font-size: 0.9em;
    border-radius: 3px;
}

.cv-bloc a {
    color: #ff5a13;
    text-decoration: none;
}

.cv-bloc a:hover {
    text-decoration: underline;
}

@media print {
    .no-print { display: none; }
    .cv-layout { display: flex; }
}

@media (max-width: 768px) {
    .cv-layout { flex-direction: column; }
    .cv-sidebar { width: 100%; }
    .competences-grid { grid-template-columns: 1fr; }
}
</style>
{% endblock %}